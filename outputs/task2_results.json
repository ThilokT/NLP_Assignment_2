{
  "llm": "google/gemma-2-2b-it",
  "bertscore_backbone": "roberta-large",
  "nli_model": "potsawee/deberta-v3-large-mnli",
  "resampling_protocol": {
    "N": 20,
    "temperature": 1.0,
    "top_p": 1.0,
    "top_k": 0,
    "max_new_tokens": 48,
    "seed": "42+sample_id",
    "prompt": "chat template, short direct answer, closed-book (no knowledge passage)"
  },
  "random_seed_split": 42,
  "metrics": {
    "full (all 800 instances)": {
      "SelfCheck-BERTScore (mean, primary)": {
        "AUC-PR": 0.429,
        "pairwise_acc": 0.4425
      },
      "SelfCheck-NLI (primary)": {
        "AUC-PR": 0.5785,
        "pairwise_acc": 0.5925
      },
      "BERTScore (max-over-samples, ablation)": {
        "AUC-PR": 0.4755,
        "pairwise_acc": 0.51
      },
      "NLI + question context (ablation)": {
        "AUC-PR": 0.5467,
        "pairwise_acc": 0.59
      }
    },
    "test split (160 instances)": {
      "SelfCheck-BERTScore (mean, primary)": {
        "AUC-PR": 0.4367,
        "pairwise_acc": 0.4875
      },
      "SelfCheck-NLI (primary)": {
        "AUC-PR": 0.5794,
        "pairwise_acc": 0.525
      },
      "BERTScore (max-over-samples, ablation)": {
        "AUC-PR": 0.4783,
        "pairwise_acc": 0.5
      },
      "NLI + question context (ablation)": {
        "AUC-PR": 0.5197,
        "pairwise_acc": 0.5875
      }
    }
  }
}